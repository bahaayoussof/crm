# API base URL, including the `/api` prefix. Client calls prepend paths like
# `/tickets` and `/auth/login`, and the SSE stream is `${VITE_API_URL}/realtime/events`.
#   - local dev:  http://localhost:3000/api  (the default when unset in a dev build)
#   - deployed:   https://<server-domain>/api  (set as a Vercel Project Environment Variable)
# Required for production/demo builds — a deployed bundle with no VITE_API_URL
# throws at startup rather than falling back to localhost. Public build-time value:
# never put a secret here.
VITE_API_URL=http://localhost:3000/api

# Public demo mode (client). Set to "true" ONLY on the demo Vercel project.
# When "true": the login page shows the one-click "Try the demo" role buttons and
# a lightweight "Demo Environment" banner renders globally. Anything else (unset
# or "false") = normal app, no demo UI. Build-time constant — must be present at
# `vite build` time, not injected at runtime.
VITE_DEMO_MODE=false
