VITE_API_URL=http://localhost:3000/api

# Public demo mode (client). Set to "true" ONLY on the demo Vercel project.
# When "true": the login page shows the one-click "Try the demo" role buttons and
# a lightweight "Demo Environment" banner renders globally. Anything else (unset
# or "false") = normal app, no demo UI. Build-time constant — must be present at
# `vite build` time, not injected at runtime.
VITE_DEMO_MODE=false
