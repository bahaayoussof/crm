# ---------------------------------------------------------------------------
# server/.env.demo  — ISOLATED public-demo configuration
#
# Copy to server/.env.demo and fill in the real values:
#     Copy-Item .env.demo.example .env.demo      # PowerShell
#     cp .env.demo.example .env.demo             # macOS / Linux
#
# server/.env.demo is git-ignored and is loaded ONLY by the demo scripts:
#     npm run db:demo:deploy   (prisma migrate deploy against the demo DB)
#     npm run demo:seed
#     npm run demo:reset
# It NEVER affects `npm run dev`, `npm start` or `npm run db:deploy`, and the
# deployed Vercel app never reads it (Vercel uses Project Settings env vars).
#
# Every value below overrides a stale shell export for demo commands.
# Do NOT put DEMO_RESET_CONFIRM here — pass it in the shell at reset time only.
# ---------------------------------------------------------------------------

# Pooled connection string for the ISOLATED Neon demo database. Never the
# development or production database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Tags this connection as the demo database. Demo scripts refuse to run without it.
DATABASE_ENV=demo

# Turns the CRM into the safe portfolio demo (provider transports simulated,
# demo accounts protected, tight AI rate limit).
DEMO_MODE=true

# A NEW random secret used only by the demo (>= 32 chars). Not the dev secret.
JWT_SECRET="replace-with-a-long-random-demo-secret"
