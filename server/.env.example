DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm
PORT=3000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CRON_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
# Private Vercel Blob store read-write token (feature/attachments).
# Server-side only. Never expose to the browser. Leave unset to disable attachment
# upload/download with a structured STORAGE_UNAVAILABLE response.
BLOB_READ_WRITE_TOKEN=

# WhatsApp Cloud API integration (server/src/modules/integrations/whatsapp).
# Server-side only. Never expose to the browser. All optional: leave unset in
# development/testing — the rest of the CRM works unchanged and WhatsApp transport
# returns a structured WHATSAPP_NOT_CONFIGURED error when specifically invoked.
# Permanent or long-lived access token for the WhatsApp Business phone number.
WHATSAPP_ACCESS_TOKEN=
# The Phone Number ID (NOT the phone number) from the Meta app's WhatsApp settings.
WHATSAPP_PHONE_NUMBER_ID=
# Arbitrary string you also paste into the Meta webhook "Verify token" field.
WHATSAPP_VERIFY_TOKEN=
# The Meta App Secret — used to verify the X-Hub-Signature-256 header on webhooks.
WHATSAPP_APP_SECRET=
# Graph API version. Optional, defaults to v22.0.
WHATSAPP_API_VERSION=v22.0
