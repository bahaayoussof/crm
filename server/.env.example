DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm
PORT=3000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CRON_SECRET=replace-with-a-separate-random-secret-at-least-32-characters

# Public base URL of the web client. Used to build absolute links in emails
# (e.g. the password-reset link). Optional: defaults to CLIENT_URL when unset.
APP_URL=http://localhost:5173

# Transactional email (server/src/modules/email). Server-side only. Never expose
# to the browser. Optional: leave RESEND_API_KEY / EMAIL_FROM unset in
# development/testing — the email service then logs each message (including the
# password-reset URL) to the server console instead of sending it.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Resend-managed *.resend.app address works without a custom domain.
EMAIL_INBOUND_ADDRESS=
# Development sender example. The resend.dev sender can normally send only to
# the Resend account owner's address; use a verified-domain sender in production.
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=CRM Support
# Private Vercel Blob store read-write token (feature/attachments).
# Server-side only. Never expose to the browser. Leave unset to disable attachment
# upload/download with a structured STORAGE_UNAVAILABLE response.
BLOB_READ_WRITE_TOKEN=

# WhatsApp Cloud API integration (server/src/modules/integrations/whatsapp).
# Server-side only. Never expose to the browser. All optional: leave unset in
# development/testing — the rest of the CRM works unchanged and WhatsApp transport
# returns a structured WHATSAPP_NOT_CONFIGURED error when specifically invoked.
# Permanent or long-lived access token for the WhatsApp Business phone number.
WHATSAPP_ACCESS_TOKEN=
# The Phone Number ID (NOT the phone number) from the Meta app's WhatsApp settings.
WHATSAPP_PHONE_NUMBER_ID=
# Arbitrary string you also paste into the Meta webhook "Verify token" field.
WHATSAPP_VERIFY_TOKEN=
# The Meta App Secret — used to verify the X-Hub-Signature-256 header on webhooks.
WHATSAPP_APP_SECRET=
# Graph API version. Optional, defaults to v22.0.
WHATSAPP_API_VERSION=v22.0

# AI Assistant (server/src/modules/ai). Internal agent-assistance only — never
# exposed to the browser. All optional: leave unset in development/testing and the
# CRM works unchanged; the AI endpoints then return a structured AI_NOT_CONFIGURED
# error and the AI panel is hidden in the client.
# First concrete adapter: OpenRouter (https://openrouter.ai) via native fetch.
# Any other value disables the AI feature (503 AI_NOT_CONFIGURED) — it never
# crashes startup and is never silently routed to OpenRouter.
AI_PROVIDER=openrouter
# OpenRouter API key. Server-side only. Never commit a real key.
AI_API_KEY=
# Model id passed straight to OpenRouter. This is the ONLY place the model is
# chosen. Initial development/demo model below; replace freely without code changes.
AI_MODEL=z-ai/glm-5.2:free
# Per-request timeout in milliseconds. Optional, defaults to 20000.
AI_TIMEOUT_MS=20000
