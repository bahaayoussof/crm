generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  role                Role
  departmentId        String?
  branchId            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  isActive            Boolean              @default(true)
  passwordChangedAt   DateTime?
  phone               String?
  teamId              String?
  auditLogs           AuditLog[]
  customerProfile     Customer?
  customerNotes       CustomerNote[]
  knowledgeArticles   KnowledgeArticle[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  quickReplies        QuickReply[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  managedTeam         Team?                @relation("TeamManager")
  assignedTickets     Ticket[]             @relation("AssignedAgent")
  stagedAttachments   Attachment[]         @relation("AttachmentStagedBy")
  ticketHistory       TicketHistory[]
  ticketMentions      TicketMention[]
  ticketMessages      TicketMessage[]
  ticketNotes         TicketNote[]
  ticketWatchers      TicketWatcher[]
  branch              Branch?              @relation(fields: [branchId], references: [id])
  department          Department?          @relation(fields: [departmentId], references: [id])
  team                Team?                @relation("TeamMembers", fields: [teamId], references: [id])

  @@index([role])
  @@index([departmentId])
  @@index([branchId])
  @@index([teamId])
}

model Customer {
  id          String         @id @default(cuid())
  name        String
  email       String         @unique
  phone       String?
  userId      String?        @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  attachments Attachment[]
  user        User?          @relation(fields: [userId], references: [id])
  notes       CustomerNote[]
  feedback    Feedback[]
  tickets     Ticket[]
}

model Ticket {
  id                 String          @id @default(cuid())
  subject            String
  description        String
  status             TicketStatus    @default(OPEN)
  priority           TicketPriority  @default(MEDIUM)
  channel            Channel         @default(WEB)
  customerId         String
  assignedAgentId    String?
  categoryId         String?
  departmentId       String?
  branchId           String?
  firstResponseDueAt DateTime?
  firstRespondedAt   DateTime?
  resolutionDueAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  emailThreadToken   String?         @unique
  teamId             String?
  liveChatSessionKey String?         @unique
  attachments        Attachment[]
  feedback           Feedback?
  notifications      Notification[]
  tasks              Task[]
  assignedAgent      User?           @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  branch             Branch?         @relation(fields: [branchId], references: [id])
  category           Category?       @relation(fields: [categoryId], references: [id])
  customer           Customer        @relation(fields: [customerId], references: [id])
  department         Department?     @relation(fields: [departmentId], references: [id])
  team               Team?           @relation(fields: [teamId], references: [id])
  history            TicketHistory[]
  mentions           TicketMention[]
  messages           TicketMessage[]
  notes              TicketNote[]
  watchers           TicketWatcher[]

  @@index([customerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([priority])
  @@index([categoryId])
  @@index([departmentId])
  @@index([branchId])
  @@index([teamId])
  @@index([createdAt])
}

model TicketMessage {
  id                String                     @id @default(cuid())
  ticketId          String
  authorUserId      String
  body              String
  createdAt         DateTime                   @default(now())
  externalId        String?                    @unique
  externalMessageId String?                    @unique
  inboundKey        String?                    @unique
  contentFormat     ConversationContentFormat
  contentSource     ConversationContentSource
  attachments       Attachment[]
  author            User                       @relation(fields: [authorUserId], references: [id])
  ticket            Ticket                     @relation(fields: [ticketId], references: [id])
  delivery          MessageDelivery?

  @@index([ticketId, createdAt])
  @@index([authorUserId])
}

model TicketNote {
  id            String                     @id @default(cuid())
  ticketId      String
  authorUserId  String
  body          String
  createdAt     DateTime                   @default(now())
  contentFormat ConversationContentFormat
  contentSource ConversationContentSource
  mentions      TicketMention[]
  attachments   Attachment[]
  author        User                       @relation(fields: [authorUserId], references: [id])
  ticket        Ticket                     @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
  @@index([authorUserId])
}

model MessageDelivery {
  id               String        @id @default(cuid())
  messageId        String        @unique
  channel          Channel
  status           DeliveryStatus @default(PENDING)
  providerMessageId String?
  attemptCount     Int           @default(0)
  lastErrorCode    String?
  lastErrorMessage String?
  claimedUntil     DateTime?
  nextAttemptAt    DateTime?
  firstAttemptedAt DateTime?
  lastAttemptedAt  DateTime?
  sentAt           DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  message          TicketMessage @relation(fields: [messageId], references: [id])

  @@unique([channel, providerMessageId])
  @@index([status, nextAttemptAt])
}

model TicketWatcher {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
}

model TicketMention {
  id              String     @id @default(cuid())
  noteId          String
  mentionedUserId String
  ticketId        String
  createdAt       DateTime   @default(now())
  mentionedUser   User       @relation(fields: [mentionedUserId], references: [id])
  note            TicketNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  ticket          Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([noteId, mentionedUserId])
  @@index([ticketId])
  @@index([mentionedUserId])
}

model CustomerNote {
  id           String   @id @default(cuid())
  customerId   String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())
  author       User     @relation(fields: [authorUserId], references: [id])
  customer     Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([authorUserId])
}

model Attachment {
  id             String         @id @default(cuid())
  ticketId       String?
  messageId      String?
  noteId         String?
  customerId     String?
  // CONV-041 — staged (unbound) conversation attachment ownership. Set only
  // while ticketId/messageId/noteId/customerId are all null; cleared (left
  // null) once the row is bound to its owning message/note. Never set
  // alongside a bound context.
  stagedByUserId String?
  fileName       String
  mimeType       String
  storageKey     String         @unique
  createdAt      DateTime       @default(now())
  externalId     String?        @unique
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  message        TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Restrict)
  note           TicketNote?    @relation(fields: [noteId], references: [id], onDelete: Restrict)
  ticket         Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  stagedBy       User?          @relation("AttachmentStagedBy", fields: [stagedByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([messageId])
  @@index([noteId])
  @@index([customerId])
  @@index([stagedByUserId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tickets     Ticket[]

  @@index([isActive])
}

model TicketHistory {
  id          String   @id @default(cuid())
  ticketId    String
  actorUserId String?
  action      String
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])
  ticket      Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
  @@index([actorUserId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SlaRule {
  id                   String         @id @default(cuid())
  priority             TicketPriority @unique
  firstResponseMinutes Int
  resolutionMinutes    Int
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model KnowledgeArticle {
  id          String                 @id @default(cuid())
  title       String
  content     String
  category    String?
  status      KnowledgeArticleStatus @default(DRAFT)
  createdById String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  contentText String?
  createdBy   User                   @relation(fields: [createdById], references: [id])

  @@index([status])
  @@index([createdById])
  @@index([category])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  ticketId  String?
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id])
  ticket    Ticket?   @relation(fields: [ticketId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
  @@index([ticketId])
  @@index([taskId])
}

model Feedback {
  id         String   @id @default(cuid())
  ticketId   String   @unique
  customerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
  ticket     Ticket   @relation(fields: [ticketId], references: [id])

  @@index([customerId])
  @@index([rating])
}

model QuickReply {
  id          String   @id @default(cuid())
  title       String
  body        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([createdById])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  branchId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  isActive    Boolean  @default(true)
  branch      Branch?  @relation(fields: [branchId], references: [id])
  teams       Team[]
  tickets     Ticket[]
  users       User[]

  @@unique([branchId, name])
  @@index([isActive])
  @@index([branchId])
}

model Team {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  managerId    String?    @unique
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
  manager      User?      @relation("TeamManager", fields: [managerId], references: [id])
  tickets      Ticket[]
  members      User[]     @relation("TeamMembers")

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([managerId])
  @@index([isActive])
}

model Branch {
  id          String       @id @default(cuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  code        String?      @unique
  address     String?
  isActive    Boolean      @default(true)
  departments Department[]
  tickets     Ticket[]
  users       User[]

  @@index([isActive])
}

model Task {
  id            String         @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus     @default(OPEN)
  dueAt         DateTime?
  remindedAt    DateTime?
  ticketId      String?
  creatorId     String
  assigneeId    String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  assignee      User           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator       User           @relation("TaskCreator", fields: [creatorId], references: [id])
  ticket        Ticket?        @relation(fields: [ticketId], references: [id])

  @@index([creatorId])
  @@index([assigneeId])
  @@index([ticketId])
  @@index([status, dueAt, remindedAt])
}

enum Role {
  ADMIN
  MANAGER
  AGENT
  CUSTOMER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  ESCALATED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Channel {
  WEB
  EMAIL
  WHATSAPP
  SMS
  LIVE_CHAT
}

enum ConversationContentFormat {
  PLAIN_TEXT
  SANITIZED_HTML
}

enum ConversationContentSource {
  STAFF
  PORTAL
  EMAIL
  SMS
  WHATSAPP
  LIVE_CHAT
  SYSTEM
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
}

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
}

enum TaskStatus {
  OPEN
  DONE
}
