# ============================================
# Dependencies
# ============================================

node_modules/
**/node_modules/

# ============================================
# Environment variables / secrets
# ============================================

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

client/.env
client/.env.local
client/.env.development.local
client/.env.test.local
client/.env.production.local

server/.env
server/.env.local
server/.env.development.local
server/.env.test.local
server/.env.production.local
server/.env.demo

# Keep safe examples in Git
!.env.example
!client/.env.example
!server/.env.example
!server/.env.demo.example

# ============================================
# Build output
# ============================================

dist/
build/
out/

client/dist/
client/build/

server/dist/
server/build/

# ============================================
# Vite / frontend caches
# ============================================

.vite/
client/.vite/

# ============================================
# TypeScript build metadata
# ============================================

*.tsbuildinfo

# ============================================
# Test coverage / test output
# ============================================

coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

client/coverage/
server/coverage/

# ============================================
# Logs
# ============================================

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# Runtime / temporary files
# ============================================

tmp/
temp/
.cache/
*.tmp
*.temp
*.pid
*.seed
*.pid.lock

# ============================================
# Local file uploads
# ============================================
# Do not commit customer/ticket uploaded files.
# Keep an empty directory with .gitkeep if needed.

server/uploads/*
!server/uploads/.gitkeep

uploads/*
!uploads/.gitkeep

# ============================================
# Prisma / database local artifacts
# ============================================

# PostgreSQL is the planned database, so normally
# no database file exists in the repository.
# These rules protect against accidental local DBs.

*.db
*.db-journal
*.sqlite
*.sqlite3

# Do NOT ignore Prisma migrations:
# server/prisma/migrations/ should remain tracked.

# ============================================
# Vercel
# ============================================

.vercel/
client/.vercel/
server/.vercel/

# ============================================
# Package manager / tooling caches
# ============================================

.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.eslintcache
.stylelintcache

# ============================================
# IDE / editor files
# ============================================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

